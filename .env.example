# InfraVault Environment Variables Template (Placeholders Only - Never Commit Real Secrets)

# Backend Spring Profile (use 'prod' in Render production)
SPRING_PROFILES_ACTIVE=prod

# Neon PostgreSQL Connection (JDBC format recommended; postgresql:// URIs are also auto-normalized)
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_DIRECT_HOST:5432/infravault?sslmode=require&channelBinding=require
SPRING_DATASOURCE_USERNAME=YOUR_NEON_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_DB_PASSWORD

# Alternative DB_* variables (supported if SPRING_DATASOURCE_* are not set)
# DB_URL=jdbc:postgresql://YOUR_NEON_DIRECT_HOST:5432/infravault?sslmode=require&channelBinding=require
# DB_USERNAME=YOUR_NEON_DB_USER
# DB_PASSWORD=YOUR_NEON_DB_PASSWORD

# Schema Management (Flyway handles migrations; keep validate in production)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Security Secrets (Required in production; do not use dev defaults)
# JWT_SECRET must be at least 32 bytes; APP_ENCRYPTION_KEY must be exactly 32 characters (AES-256)
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_KEY
APP_ENCRYPTION_KEY=REPLACE_WITH_EXACT_32_CHAR_AES_KEY

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://arshitas16.github.io,http://localhost:5173,http://localhost:5174

# Optional Initial SUPER_ADMIN Bootstrap (runs only when users table is empty)
ADMIN_INIT_USERNAME=
ADMIN_INIT_EMAIL=
ADMIN_INIT_PASSWORD=

# Frontend Build Variable
VITE_API_URL=https://infravault-backend-znmg.onrender.com
